<Window x:Class="Remake.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#101722" Foreground="#E6EDF7" FontFamily="Microsoft YaHei UI" FontSize="13" Title="SteamAchievementManager-Remake" Width="1240" Height="820" MinWidth="1000" MinHeight="650" WindowStartupLocation="CenterScreen">
<DockPanel>
<Border DockPanel.Dock="Top" Background="#131F2E" BorderBrush="#293B50" BorderThickness="0,0,0,1" Padding="20,6">
<StackPanel Orientation="Horizontal">
<Button x:Name="SettingsButton" Content="{DynamicResource loc_47}" Click="OpenSettings" Padding="16,6" Margin="0"/>
<Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Bottom" VerticalOffset="6" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
<Border Width="350" Background="#172537" BorderBrush="#3C526B" BorderThickness="1" CornerRadius="8" TextElement.Foreground="#E6EDF7"><StackPanel Margin="18"><TextBlock Text="{DynamicResource loc_48}" FontSize="23"/><ComboBox x:Name="LanguageSelector" Width="220" HorizontalAlignment="Left" Margin="0,16,0,12" SelectionChanged="ChangeLanguage"><ComboBoxItem Content="English"/><ComboBoxItem Content="简体中文"/></ComboBox><TextBlock Text="{DynamicResource loc_49}" Foreground="#A4B4CA" TextWrapping="Wrap"/></StackPanel></Border>
</Popup></StackPanel></Border>
<Grid Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Background="#172232" CornerRadius="12" Padding="16"><DockPanel>
<StackPanel DockPanel.Dock="Top"><TextBlock Text="SAM / REMAKE" FontSize="22" FontWeight="Bold" Foreground="#60D5C4"/><TextBlock Text="{DynamicResource loc_0}" Foreground="#A4B4CA" Margin="0,8,0,22"/>
<TextBlock Text="{DynamicResource loc_1}" Foreground="#A4B4CA" Margin="0,0,0,6"/><TextBox x:Name="GameSearch" ToolTip="{DynamicResource loc_2}" TextChanged="SearchGames"/>
<Button Content="{DynamicResource loc_3}" Click="LoadGames" Margin="0,12,0,12"/>
<TextBlock Text="{DynamicResource loc_4}" Foreground="#A4B4CA" Margin="0,0,0,6"/><TextBox x:Name="AppIdInput" ToolTip="{DynamicResource loc_5}"/><Button Content="{DynamicResource loc_6}" Click="OpenId" Margin="0,8,0,14"/></StackPanel>
<StackPanel DockPanel.Dock="Bottom"><TextBlock Text="{DynamicResource loc_7}" Foreground="#60D5C4" Margin="0,16,0,8"/><Button Content="{DynamicResource loc_8}" Click="Advanced" Margin="0,0,0,8"/><TextBlock Text="{DynamicResource loc_9}" TextWrapping="Wrap" Foreground="#8D9EB5" FontSize="11"/></StackPanel>
<ListBox x:Name="Games" Background="Transparent" Foreground="White" BorderThickness="0" DisplayMemberPath="Label" SelectionChanged="PickGame"/></DockPanel></Border>
<Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Margin="0,2,0,18"><TextBlock Text="{DynamicResource loc_10}" FontSize="30" FontWeight="Bold"/><TextBlock x:Name="GameTitle" Text="{DynamicResource loc_11}" Margin="0,8,0,10" Foreground="#9FB0C8"/><TextBlock x:Name="Summary" Text="{DynamicResource loc_12}" Foreground="#60D5C4"/></StackPanel>
<TabControl Grid.Row="1" x:Name="Tabs" Background="#151F2D" BorderThickness="0">
<TabItem Header="{DynamicResource loc_13}"><DockPanel Margin="12">
<WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12"><TextBlock Foreground="#AABBD0" Text="{DynamicResource loc_14}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="AchievementSearch" Width="220" TextChanged="FilterAchievements" ToolTip="{DynamicResource loc_15}" Margin="0,0,8,0"/><ComboBox x:Name="StateFilter" SelectedIndex="0" SelectionChanged="FilterAchievements"><ComboBoxItem Content="{DynamicResource loc_16}"/><ComboBoxItem Content="{DynamicResource loc_17}"/><ComboBoxItem Content="{DynamicResource loc_18}"/></ComboBox><ComboBox x:Name="Sort" SelectedIndex="0" SelectionChanged="FilterAchievements" Margin="8,0,0,0"><ComboBoxItem Content="{DynamicResource loc_19}"/><ComboBoxItem Content="{DynamicResource loc_20}"/><ComboBoxItem Content="{DynamicResource loc_21}"/><ComboBoxItem Content="{DynamicResource loc_22}"/></ComboBox></WrapPanel>
<WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><Button Content="{DynamicResource loc_23}" Click="Refresh"/><Button Content="{DynamicResource loc_24}" Click="Unlock"/><Button Content="{DynamicResource loc_25}" Click="Relock"/><Button Content="{DynamicResource loc_26}" Click="Export"/><Button Content="{DynamicResource loc_27}" Click="Import"/></WrapPanel>
<DataGrid x:Name="Achievements" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="{DynamicResource loc_13}" Binding="{Binding Name}" Width="180"/><DataGridTextColumn Header="{DynamicResource loc_29}" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="{DynamicResource loc_30}" Binding="{Binding State}" Width="85"/><DataGridTextColumn Header="{DynamicResource loc_31}" Binding="{Binding TimeText}" Width="180"/><DataGridTextColumn Header="{DynamicResource loc_32}" Binding="{Binding Percent}" Width="70"/></DataGrid.Columns></DataGrid>
</DockPanel></TabItem>
<TabItem Header="{DynamicResource loc_33}"><DockPanel Margin="12"><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0"><TextBox x:Name="StatValue" Width="190" ToolTip="{DynamicResource loc_34}" Margin="0,0,8,0"/><Button Content="{DynamicResource loc_35}" Click="SaveStat"/><TextBlock Text="{DynamicResource loc_36}" VerticalAlignment="Center" Foreground="#9FB0C8"/></StackPanel><DataGrid x:Name="Stats" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="{DynamicResource loc_37}" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="API ID" Binding="{Binding Id}" Width="220"/><DataGridTextColumn Header="{DynamicResource loc_38}" Binding="{Binding Value}" Width="120"/><DataGridTextColumn Header="{DynamicResource loc_39}" Binding="{Binding Access}" Width="140"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
<TabItem Header="{DynamicResource loc_40}"><StackPanel Margin="24"><TextBlock Text="{DynamicResource loc_41}" FontSize="23"/><TextBlock Text="{DynamicResource loc_42}" TextWrapping="Wrap" Foreground="#9FB0C8" Margin="0,12,0,18"/><StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource loc_43}" VerticalAlignment="Center"/><TextBox x:Name="Interval" Text="60" Width="100" Margin="12,0"/><Button Content="{DynamicResource loc_44}" Click="Schedule"/><Button Content="{DynamicResource loc_45}" Click="StopSchedule"/></StackPanel><TextBlock x:Name="QueueStatus" Text="{DynamicResource loc_46}" Margin="0,20,0,12"/><TextBox x:Name="QueueLog" IsReadOnly="True" Height="280" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel></TabItem>
</TabControl>
<Border Grid.Row="2" Background="#1C2A3C" CornerRadius="8" Padding="12" Margin="0,14,0,0"><DockPanel><Button x:Name="CancelReadButton" DockPanel.Dock="Right" Content="{DynamicResource loc_50}" Click="CancelRead" IsEnabled="False" Margin="12,0,0,0"/><StackPanel>
<TextBlock x:Name="Status" Text="{DynamicResource loc_51}" TextWrapping="Wrap"/>
<StackPanel x:Name="ReadProgressPanel" Visibility="Collapsed" Margin="0,8,0,0">
<ProgressBar x:Name="ReadProgress" Height="5" IsIndeterminate="False" Foreground="#60D5C4" Background="#31445C" BorderThickness="0" AutomationProperties.Name="{DynamicResource loc_52}"/>
<TextBlock x:Name="ReadElapsed" Foreground="#A4B4CA" FontSize="11" Margin="0,5,0,0"/>
</StackPanel></StackPanel></DockPanel></Border>
</Grid></Grid></DockPanel></Window>
